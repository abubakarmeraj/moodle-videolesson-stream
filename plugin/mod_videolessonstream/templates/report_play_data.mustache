{{!
    @template mod_videolessonstream/report_play_data

    Report detail view for a single play record.
}}

<p>
  {{#str}}report:play:user, mod_videolessonstream{{/str}} {{{user.fullname}}} <br>
  {{#str}}report:play:time, mod_videolessonstream{{/str}} {{{sessiondata.timestamp}}} <br>
  {{#str}}report:play:city, mod_videolessonstream{{/str}} {{{sessiondata.city}}} <br>
  {{#str}}report:play:country, mod_videolessonstream{{/str}} {{{sessiondata.country}}} <br>
  {{#str}}report:play:ip, mod_videolessonstream{{/str}} {{{sessiondata.ip}}} <br>
  {{#str}}report:play:platform, mod_videolessonstream{{/str}} {{{sessiondata.platform}}} <br>
  {{#str}}report:play:browser, mod_videolessonstream{{/str}} {{{sessiondata.browser}}} <br>
  {{#str}}report:play:os, mod_videolessonstream{{/str}} {{{sessiondata.os}}} <br>
</p>

<hr>

<h5>
  {{#str}}report:play:playback:header, mod_videolessonstream{{/str}}
</h5>

<table class="table">
  <thead>
    <tr>
      <th scope="col">{{#str}}report:play:playback:col:type, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:playback:col:time, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:playback:col:position, mod_videolessonstream{{/str}}</th>
    </tr>
  </thead>
  <tbody>
    {{#sessiondata.playbackEvents}}
      <tr>
        <td>{{{event_type}}}</td>
        <td>{{{timestamp}}}</td>
        <td>{{{position}}}</td>
      </tr>
    {{/sessiondata.playbackEvents}}
    {{^sessiondata.playbackEvents}}
    <tr>
        <td colspan="3">{{#str}}report:nodata, mod_videolessonstream{{/str}}</td>
    </tr>
    {{/sessiondata.playbackEvents}}
  </tbody>
</table>

<hr>

<h5>
  {{#str}}report:play:seek:header, mod_videolessonstream{{/str}}
</h5>

<table class="table">
  <thead>
    <tr>
      <th scope="col">{{#str}}report:play:seek:col:time, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:seek:col:startposition, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:seek:col:newposition, mod_videolessonstream{{/str}}</th>
    </tr>
  </thead>
  <tbody>
    {{#sessiondata.seekEvents}}
      <tr>
        <td>{{{timestamp}}}</td>
        <td>{{{start}}}</td>
        <td>{{{position}}}</td>
      </tr>
    {{/sessiondata.seekEvents}}
    {{^sessiondata.seekEvents}}
    <tr>
        <td colspan="3">{{#str}}report:nodata, mod_videolessonstream{{/str}}</td>
    </tr>
    {{/sessiondata.seekEvents}}
  </tbody>
</table>
<hr>

<h5>
  {{#str}}report:play:visibility:header, mod_videolessonstream{{/str}}
</h5>

<table class="table">
  <thead>
    <tr>
      <th scope="col">{{#str}}report:play:visibility:col:time, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:visibility:col:position, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:visibility:col:active, mod_videolessonstream{{/str}}</th>
    </tr>
  </thead>
  <tbody>
    {{#sessiondata.visibility}}
      <tr>
        <td>{{{timestamp}}}</td>
        <td>{{{position}}}</td>
        <td>{{#active}}{{#str}}report:play:visibility:yes, mod_videolessonstream{{/str}}{{/active}}{{^active}}{{#str}}report:play:visibility:no, mod_videolessonstream{{/str}}{{/active}}</td>
      </tr>
    {{/sessiondata.visibility}}
    {{^sessiondata.visibility}}
    <tr>
        <td colspan="3">{{#str}}report:nodata, mod_videolessonstream{{/str}}</td>
    </tr>
    {{/sessiondata.visibility}}
  </tbody>
</table>

<hr>

<h5>
  {{#str}}report:play:volume:header, mod_videolessonstream{{/str}}
</h5>

<table class="table">
  <thead>
    <tr>
      <th scope="col">{{#str}}report:play:volume:col:time, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:volume:col:position, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:volume:col:level, mod_videolessonstream{{/str}}</th>
    </tr>
  </thead>
  <tbody>
    {{#sessiondata.volumeChanges}}
      <tr>
        <td>{{{timestamp}}}</td>
        <td>{{{position}}}</td>
        <td>{{{volume_level}}}</td>
      </tr>
    {{/sessiondata.volumeChanges}}
    {{^sessiondata.volumeChanges}}
    <tr>
        <td colspan="3">{{#str}}report:nodata, mod_videolessonstream{{/str}}</td>
    </tr>
    {{/sessiondata.volumeChanges}}
  </tbody>
</table>

<hr>
<h5>
  {{#str}}report:play:quality:header, mod_videolessonstream{{/str}}
</h5>

<table class="table">
  <thead>
    <tr>
      <th scope="col">{{#str}}report:play:quality:col:time, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:quality:col:position, mod_videolessonstream{{/str}}</th>
      <th scope="col">{{#str}}report:play:quality:col:quality, mod_videolessonstream{{/str}}</th>
    </tr>
  </thead>
  <tbody>
    {{#sessiondata.qualityChanges}}
      <tr>
        <td>{{{timestamp}}}</td>
        <td>{{{position}}}</td>
        <td>{{{quality}}}</td>
      </tr>
    {{/sessiondata.qualityChanges}}
    {{^sessiondata.qualityChanges}}
    <tr>
        <td colspan="3">{{#str}}report:nodata, mod_videolessonstream{{/str}}</td>
    </tr>
    {{/sessiondata.qualityChanges}}
  </tbody>
</table>

<hr>
